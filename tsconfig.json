{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "outDir": ".homeybuild/",
    "rootDir": ".",
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "sourceMap": false
  },
  "include": [
    "app.ts",
    "drivers/**/*.ts",
    "lib/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": [
    ".homeybuild",
    "node_modules",
    "test"
  ]
}
